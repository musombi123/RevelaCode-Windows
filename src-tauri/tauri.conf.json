{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RevelaCode",
  "version": "0.1.2",
  "identifier": "co.ke.revelacode.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix workspace/frontend run dev -- --host 127.0.0.1",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm --prefix workspace/frontend run build",
    "frontendDist": "../workspace/frontend/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "RevelaCode",
        "width": 1440,
        "height": 920,
        "minWidth": 1080,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "Business",
    "shortDescription": "RevelaCode Desktop",
    "longDescription": "The RevelaCode ecosystem in one Windows desktop application.",
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
